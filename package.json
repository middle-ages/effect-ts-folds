{
  "name": "effect-ts-folds",
  "version": "1.0.3",
  "description": "Recursion schemes for effect-ts.",
  "type": "module",
  "author": "Ran Eilam <ran@haag59.com> (https://middle-ages.github.io/)",
  "homepage": "https://github.com/middle-ages/effect-ts-folds",
  "bugs": "https://github.com/middle-ages/effect-folds/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middle-ages/effect-ts-folds.git"
  },
  "license": "ISC",
  "keywords": [
    "effect-ts",
    "fast-check",
    "recursion-schemes"
  ],
  "scripts": {
    "clean": "dev/clean",
    "lint": "eslint --config config/eslint.config.js src tests",
    "lint:fix": "eslint --config config/eslint.config.js --fix src tests",
    "typecheck:src": "tsc --project config/tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc --project tests/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:tests",
    "circular": "depcruise src --config config/dependency-cruiser.cjs",
    "graph:dependencies": "dev/graph-dependencies",
    "test": "vitest --config config/vitest.conf.ts --reporter=verbose",
    "coverage": "vitest --config config/vitest.conf.ts run --reporter=verbose --coverage",
    "test:run": "vitest --config config/vitest.conf.ts run",
    "build": "tsc --project config/tsconfig.build.json",
    "ls:deps": "pnpm ls --prod",
    "ls:deps:dev": "pnpm ls --dev",
    "npm": "dev/publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@fast-check/vitest": "^0.1.5",
    "@tsconfig/node-lts": "^22.0.1",
    "@tsconfig/strictest": "^2.0.5",
    "@types/eslint__eslintrc": "^2.1.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.5",
    "dependency-cruiser": "^16.9.0",
    "effect-ts-laws": "^1.2.3",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@effect/typeclass": "^0.31.9",
    "effect": "^3.12.9"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "bracketSameLine": true,
    "endOfLine": "lf"
  },
  "packageManager": "pnpm@9.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "import": "./src/index.js"
      }
    }
  }
}
