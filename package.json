{
  "name": "effect-ts-folds",
  "version": "1.0.21",
  "description": "Recursion schemes for effect-ts.",
  "type": "module",
  "author": "Ran Eilam <ran@haag59.com> (https://middle-ages.github.io/)",
  "homepage": "https://github.com/middle-ages/effect-ts-folds",
  "bugs": "https://github.com/middle-ages/effect-folds/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middle-ages/effect-ts-folds.git"
  },
  "license": "ISC",
  "keywords": [
    "effect-ts",
    "fast-check",
    "recursion-schemes"
  ],
  "scripts": {
    "clean": "dev/clean",
    "lint": "eslint --config config/eslint.config.ts src tests",
    "lint:fix": "eslint --config config/eslint.config.ts --fix src tests",
    "typecheck": "tsc -b --noEmit",
    "circular": "madge --circular .",
    "test": "vitest --config config/vitest.conf.ts --reporter=verbose",
    "coverage": "vitest --config config/vitest.conf.ts run --reporter=verbose --coverage",
    "test:run": "vitest --config config/vitest.conf.ts run",
    "build:docs": "dev/build-docs",
    "build": "tsc --build",
    "build:all": "dev/build-all",
    "ls:deps": "pnpm ls --prod",
    "ls:deps:dev": "pnpm ls --dev",
    "publish:docs": "dev/publish-docs",
    "npm": "dev/publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@fast-check/vitest": "^0.2.1",
    "@tsconfig/node-lts": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "effect-ts-laws": "^1.3.8",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "fast-check": "^4.1.1",
    "jiti": "^2.4.2",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@effect/typeclass": "^0.35.12",
    "effect": "^3.16.12"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "bracketSameLine": true,
    "endOfLine": "lf"
  },
  "packageManager": "pnpm@9.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "import": "./src/index.js"
      }
    }
  },
  "imports": {
    "#fold": {
      "types": "./src/fold.d.ts",
      "import": "./src/fold.js"
    },
    "#unfold": {
      "types": "./src/unfold.d.ts",
      "import": "./src/unfold.js"
    },
    "#refold": {
      "types": "./src/refold.d.ts",
      "import": "./src/refold.js"
    },
    "#fix": {
      "types": "./src/fix.d.ts",
      "import": "./src/fix.js"
    },
    "#laws": {
      "types": "./src/laws.d.ts",
      "import": "./src/laws.js"
    },
    "#util": {
      "types": "./src/util.d.ts",
      "import": "./src/util.js"
    }
  }
}
